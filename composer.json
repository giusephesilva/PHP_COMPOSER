{
    "name": "giusephesilva/buscador-cursos",
    "description": "Projeto que busca os cursos no site da alura",
    "type": "library",
    "authors": [
        {
            "name": "Giusephe",
            "email": "giusephesilva@hotmail.com"
        }
    ],
    "require": {
        "guzzlehttp/guzzle": "^8.0",
        "symfony/dom-crawler": "^8.1",
        "symfony/css-selector": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "Alura\\BuscadorDeCursos\\": "src/" 
        }
    },
    "require-dev": {
        "phpunit/phpunit": "13",
        "squizlabs/php_codesniffer": "*",
        "phan/phan": "^6.0"
    },
    "scripts": {
        "test" : "phpunit tests\\TestBuscadorDeCursos.php",
        "cs" : "phpcs --standard=PSR12 src\\",
        "phan" : "phan --allow-polyfill-parser  src\\Buscador.php",
        "check" : [ 
            "@phan", 
            "@cs",
            "@test"
        ],
        "post-update-cmd": [
            "@test"
        ]
    },
    "scripts-descriptions": {
        "check" : "Roda as verificações do codigo PHAN, PHPCS e  PHPUNIT"
    },
    "license": "GPL-3.0"

}
